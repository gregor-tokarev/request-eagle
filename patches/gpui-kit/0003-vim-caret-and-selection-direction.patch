+    #[gpui::test]
+    fn test_set_selected_range_with_direction_reveals_the_caret(cx: &mut TestAppContext) {
+        let input_view = InputView::new(cx);
+        let mut cx = VisualTestContext::from_window(input_view.window_handle.into(), cx);
+        let input = input_view.input;
+        let text = (0..160)
+            .map(|row| format!("line {row}"))
+            .collect::<Vec<_>>()
+            .join("\n");
+        cx.update(|window, cx| {
+            input.update(cx, |state, cx| state.set_value(text, window, cx));
+        });
+        cx.run_until_parked();
+
+        for (rows, reversed, caret_row) in [(10..100, false, 100), (60..150, true, 60)] {
+            cx.update(|_, cx| {
+                input.update(cx, |state, cx| {
+                    let range = state.text.line_start_offset(rows.start)
+                        ..state.text.line_start_offset(rows.end);
+                    state.set_selected_range_with_direction(range.clone(), reversed, cx);
+
+                    assert_eq!(state.selected_range(), range);
+                    assert_eq!(
+                        state.cursor(),
+                        if reversed { range.start } else { range.end }
+                    );
+                });
+            });
+            cx.run_until_parked();
+            input.read_with(&cx, |state, _| {
+                let visible = state.visible_row_range().unwrap();
+                assert!(
+                    visible.contains(&caret_row),
+                    "caret row {caret_row} outside {visible:?}"
+                );
+            });
+        }
+    }
+
+    #[gpui::test]
+    fn test_set_caret_hidden_only_hides_the_caret(cx: &mut TestAppContext) {
+        let input_view = InputView::build(cx, |state| state.default_value("hello"));
+        let mut cx = VisualTestContext::from_window(input_view.window_handle.into(), cx);
+        let input = input_view.input;
+
+        cx.update(|window, cx| {
+            window.activate_window();
+            input.update(cx, |state, cx| {
+                state.focus(window, cx);
+                state.set_selected_range(2..2, cx);
+            });
+        });
+        cx.run_until_parked();
+        cx.update(|window, cx| {
+            input.update(cx, |state, cx| {
+                // Focusing restarts blinking; pause it to show the caret now.
+                state.pause_blink_cursor(cx);
+                assert!(state.show_cursor(window, cx));
+                let caret = state.cursor_layout();
+
+                state.set_caret_hidden(true, cx);
+                assert!(!state.show_cursor(window, cx));
+                assert_eq!(state.cursor_layout(), caret);
+
+                state.set_caret_hidden(false, cx);
+                assert!(state.show_cursor(window, cx));
+            });
+        });
+    }
