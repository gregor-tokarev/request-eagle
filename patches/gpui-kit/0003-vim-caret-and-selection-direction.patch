+    /// Like [`Self::set_selected_range`], but places the caret at `range.start` when `reversed`
+    /// is true, and scrolls the caret into view instead of `range.start`.
+    ///
+    /// Use this for a selection that is extended from its end back toward its start.
+    pub fn set_selected_range_with_direction(
+        &mut self,
+        range: Range<usize>,
+        reversed: bool,
+        cx: &mut Context<Self>,
+    ) {
+        self.set_selected_range(range, cx);
+
+        let active = self.active_selection_mut();
+        active.reversed = reversed && !active.is_empty();
+        self.scroll_to(self.cursor(), None, cx);
+    }
