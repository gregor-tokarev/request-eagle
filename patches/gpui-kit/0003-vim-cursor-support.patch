+    #[gpui::test]
+    fn test_range_to_bounds_rejects_lines_scrolled_out_of_view(cx: &mut TestAppContext) {
+        let input_view = InputView::new(cx);
+        let mut cx = VisualTestContext::from_window(input_view.window_handle.into(), cx);
+        let input = input_view.input;
+        let text = (0..160)
+            .map(|row| format!("line {row}"))
+            .collect::<Vec<_>>()
+            .join("\n");
+        cx.update(|window, cx| {
+            input.update(cx, |state, cx| state.set_value(text, window, cx));
+        });
+        cx.run_until_parked();
+        cx.update(|_, cx| {
+            input.update(cx, |state, cx| {
+                let line_height = state.line_height().unwrap();
+                state.set_scroll_offset(point(px(0.), -line_height * 80.), cx);
+            });
+        });
+        cx.run_until_parked();
+
+        input.read_with(&cx, |state, _| {
+            let visible = state.visible_row_range().unwrap();
+            let above = state.text.line_start_offset(visible.start - 1) + 2;
+            let below = state.text.line_start_offset(visible.end + 1) + 2;
+            let inside = state.text.line_start_offset(visible.start + 1) + 2;
+
+            assert_eq!(state.range_to_bounds(&(above..above)), None);
+            assert_eq!(state.range_to_bounds(&(below..below)), None);
+            assert!(state.range_to_bounds(&(inside..inside)).is_some());
+        });
+    }
