---
import { getCollection } from "astro:content";
import Page from "../../layouts/Page.astro";
import { order, summary, title } from "../../guides";

import "../../styles/docs.css";

const guides = (await getCollection("docs")).sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
---

<Page
  title="Docs — Request Eagle"
  description="Guides to Request Eagle: request scripts, the Collection Runner, flows, Git, the agent panel and the CLI for agents."
  socialDescription="How to script requests, run collections, draw flows, keep collections in Git and hand Request Eagle to an agent."
>
  <main>

    <div class="hero hero--short">
      <div class="streaks" aria-hidden="true"><i></i><i></i><i></i></div>

      <div class="wrap">
        <h1 class="display">
          <span class="line"><span>Docs</span></span>
        </h1>

        <div class="hero__row">
          <div>
            <p class="lede">
              How to script requests, run whole collections, draw flows, keep collections in Git
              and hand Request Eagle to the coding agent you already use.
            </p>
          </div>
        </div>

        <div class="guides">
          {guides.map((guide) => (
            <a class="guide-card" href={`/docs/${guide.id}/`}>
              <h2 class="display">{title(guide.body)}</h2>
              <p>{summary(guide.body)}</p>
            </a>
          ))}
        </div>
      </div>
    </div>

  </main>
</Page>
