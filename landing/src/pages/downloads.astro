---
import Page from "../layouts/Page.astro";

import "../styles/downloads.css";

const latest = "https://github.com/gregor-tokarev/request-eagle/releases/latest";
---

<Page
  title="Download — Request Eagle"
  description="Download the latest stable release of Request Eagle for Apple Silicon Macs, Windows and Linux: an AppImage, Debian and RPM packages, and the AUR."
  socialDescription="Request Eagle for macOS, Windows and Linux, ready to download."
  download={false}
>
  <main>

    <div class="hero hero--short">
      <div class="streaks" aria-hidden="true"><i></i><i></i><i></i></div>

      <div class="wrap">
        <h1 class="display">
          <span class="line"><span>Download</span></span>
        </h1>

        <div class="hero__row">
          <div>
            <p class="lede">
              The latest stable release of Request Eagle for macOS, Windows and Linux.
            </p>
          </div>
        </div>

        <!-- Without the script every button leads to the latest release on GitHub; the script points them at its files. -->
        <div class="platforms" data-boost>
          <section class="platform">
            <h2 class="display">macOS</h2>
            <p>For Apple Silicon Macs. The app installs its own updates.</p>

            <div class="platform__actions">
              <a class="button" href={latest} data-file="-arm64.dmg" data-umami-event="Download" data-umami-event-package="macOS disk image"><span>Disk image</span></a>
              <a class="button button--outline" href={latest} data-file="-arm64.zip" data-umami-event="Download" data-umami-event-package="macOS ZIP"><span>ZIP</span></a>
            </div>
          </section>

          <section class="platform">
            <h2 class="display">Windows</h2>
            <p>For Windows 10 and 11 on x64. Installs for your account, without an administrator.</p>

            <div class="platform__actions">
              <a class="button" href={latest} data-file="-x64-setup.exe" data-umami-event="Download" data-umami-event-package="Windows installer"><span>Installer</span></a>
            </div>
          </section>

          <section class="platform">
            <h2 class="display">Linux</h2>
            <p>For x64. The AppImage runs on any distribution. The packages are for Debian 12, Ubuntu 22.04, Fedora and newer; Arch Linux installs <code>request-eagle-bin</code> from the AUR.</p>

            <div class="platform__actions">
              <a class="button" href={latest} data-file="-x86_64.AppImage" data-umami-event="Download" data-umami-event-package="AppImage"><span>AppImage</span></a>
              <a class="button button--outline" href={latest} data-file="_amd64.deb" data-umami-event="Download" data-umami-event-package="Debian package"><span>Debian package</span></a>
              <a class="button button--outline" href={latest} data-file=".x86_64.rpm" data-umami-event="Download" data-umami-event-package="RPM package"><span>RPM package</span></a>
              <a class="button button--outline" href="https://aur.archlinux.org/packages/request-eagle-bin" data-umami-event="Download" data-umami-event-package="AUR"><span>AUR</span></a>
            </div>
          </section>
        </div>
      </div>
    </div>

  </main>
</Page>

<script>
  import "../scripts/downloads.js";
</script>
